{
  "name": "paw-claw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:import": "node scripts/import-assets.mjs && node scripts/crop-card-sheets.mjs && npm run assets:pirates && npm run assets:groups",
    "assets:crop": "node scripts/crop-card-sheets.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:audit": "node scripts/audit-asset-coverage.mjs",
    "predev": "npm run assets:import",
    "dev": "vite",
    "prebuild": "npm run assets:import",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/data/*.test.ts",
    "test:functional": "vitest run src/*.functional.test.tsx",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run assets:validate && npm run test:unit && npm run test:functional",
    "assets:pirates": "node scripts/import-pirate-animations.mjs",
    "test:pirates": "npm run assets:pirates && node scripts/validate-pirate-animations.mjs",
    "test:groups": "npm run assets:groups && node scripts/test-group-animations.cjs",
    "assets:groups": "node scripts/import-group-animations.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "adm-zip": "^0.5.16",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
