{
  "name": "paw-claw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cards:import": "node scripts/import-cards.mjs",
    "assets:import": "node scripts/import-assets.mjs && node scripts/crop-card-sheets.mjs",
    "assets:crop": "node scripts/crop-card-sheets.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:audit": "node scripts/audit-asset-coverage.mjs",
    "predev": "npm run assets:import",
    "dev": "vite",
    "prebuild": "npm run assets:import",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src/data/*.test.ts",
    "test:functional": "vitest run src/*.functional.test.tsx",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run assets:validate && npm test",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "release:check": "npm test && npm run build && npm run assets:audit -- --cards",
    "mobile:art": "node scripts/mobile-art.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@vitejs/plugin-react": "latest",
    "adm-zip": "^0.5.16",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.34.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
