# Les annonces Google de démonstration sont utilisées tant que le mode reste test.
VITE_ADMOB_ENABLED=true
VITE_ADMOB_MODE=test

# À remplir pour chaque plateforme avant de passer en mode live.
# APP_ID contient ~ ; REWARDED_ID et INTERSTITIAL_ID contiennent /.
VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_REWARDED_ID=
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=
VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_IOS_REWARDED_ID=
VITE_ADMOB_IOS_INTERSTITIAL_ID=
